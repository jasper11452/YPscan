{
  "id": "ypscan",
  "name": "悦普识星",
  "version": "1.0.19",
  "description": "悦普识星客户端集成层：业务模式前置，支持机构询价与后台手动拓展双分支。",
  "author": {
    "name": "Jasper"
  },
  "skills": ["./skills"],
  "activation": {
    "onStartup": true,
    "onCapabilities": ["tool", "hook"]
  },
  "mcpServers": {
    "ypscan": {
      "url": "https://mcp.eshypdata.com/mcp",
      "transport": "streamable-http",
      "enabled": true,
      "connectionTimeoutMs": 5000,
      "requestTimeoutMs": 330000,
      "toolFilter": {
        "include": [
          "validate_requirement",
          "search_creators",
          "rank_mcns",
          "select_inquiry_form_fields",
          "create_with_distributions",
          "sync_mcn_inquiry_status",
          "ingest_mcn_submissions",
          "get_ingest_job",
          "manual_source_creators",
          "manual_source_creators_status",
          "score_manual_source_csv",
          "score_manual_source_csv_status",
          "rank_creators"
        ]
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "testMode": {
        "type": "boolean",
        "default": false,
        "description": "仅限隔离端到端测试。开启后仍要求生产形态业务 URL，但允许受控读取 loopback 测试 adapter。"
      },
      "testAdapterBaseUrl": {
        "type": "string",
        "description": "仅在 testMode=true 时使用；必须是无凭据的 loopback HTTP origin。"
      },
      "fileBridgeOss": {
        "type": "object",
        "additionalProperties": false,
        "description": "`file_bridge` 上传 OSS 的安装级覆盖配置；官方发布包通常已内置打包注入的凭据（见 scripts/prepare-oss-bundle.mjs），无需填写。",
        "required": ["accessKeyId", "accessKeySecret", "region", "bucket", "objectPrefix"],
        "properties": {
          "accessKeyId": {
            "type": "string",
            "minLength": 1,
            "description": "OSS AccessKey ID"
          },
          "accessKeySecret": {
            "type": "string",
            "minLength": 1,
            "description": "OSS AccessKey Secret"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "OSS Region，例如 oss-cn-shanghai"
          },
          "bucket": {
            "type": "string",
            "minLength": 1,
            "description": "OSS Bucket 名称"
          },
          "objectPrefix": {
            "type": "string",
            "minLength": 1,
            "description": "OSS 对象前缀，例如 action"
          }
        }
      }
    }
  },
  "contracts": {
    "tools": [
      "ypscan_parse_requirement",
      "ypscan_save_artifact",
      "ypscan_save_creator_links",
      "ypscan_summarize_manual_scores",
      "file_bridge"
    ]
  },
  "hooks": "./index.js"
}
