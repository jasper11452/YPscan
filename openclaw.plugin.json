{
  "id": "ypscan",
  "name": "悦普识星",
  "version": "0.1.24-beta51",
  "description": "悦普识星客户端集成层：固定 Provider 首发链路，人工拓展由 Agent 使用宿主原生 Browser 自主完成。",
  "author": {
    "name": "Jasper"
  },
  "activation": {
    "onStartup": true,
    "onCapabilities": ["tool", "hook"]
  },
  "mcpServers": {
    "ypscan": {
      "url": "https://mcp.eshypdata.com/sse",
      "transport": "sse",
      "enabled": true,
      "connectionTimeoutMs": 5000,
      "requestTimeoutMs": 330000,
      "toolFilter": {
        "include": [
          "validate_requirement",
          "search_creators",
          "rank_mcns",
          "select_inquiry_form_fields",
          "create_with_distributions",
          "sync_mcn_inquiry_status",
          "ingest_mcn_submissions",
          "rank_creators",
          "get_creator_detail",
          "get_creator_detail_export",
          "get_workflow_state",
          "create_submission_batch"
        ]
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "testMode": {
        "type": "boolean",
        "default": false,
        "description": "仅限隔离端到端测试。开启后仍要求生产形态业务 URL，但允许受控读取 loopback 测试 adapter。"
      },
      "testAdapterBaseUrl": {
        "type": "string",
        "description": "仅在 testMode=true 时使用；必须是无凭据的 loopback HTTP origin。"
      },
      "browserCdpUrl": {
        "type": "string",
        "default": "http://127.0.0.1:18800",
        "description": "仅供旧 collect 兼容路径使用的宿主 CDP 地址；人工拓展使用 YP Action Playwright CLI 独立持久 session。"
      }
    }
  },
  "contracts": {
    "tools": [
      "ypscan_parse_requirement",
      "ypscan_manual_research",
      "ypscan_save_excel_artifact"
    ]
  },
  "hooks": "./index.js"
}
