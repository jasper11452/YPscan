{
  "name": "ypscan",
  "version": "1.0.3",
  "description": "悦普识星客户端集成层：业务模式前置，支持机构询价与后台手动拓展双分支。",
  "type": "module",
  "private": true,
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "skills",
    "src/contract/registry.js",
    "src/hooks/register-flow-directives.js",
    "src/tools/manual-research/platform-cascade-routes.json",
    "src/tools/file-bridge.js",
    "src/tools/file-bridge-oss-defaults.json",
    "src/tools/merge-creator-csv.js",
    "src/tools/parse-requirement.js",
    "src/tools/popup-questions.js",
    "src/tools/save-artifact.js",
    "src/tools/save-creator-links.js",
    "src/tools/read-creator-preview.js",
    "src/tools/test-adapter.js",
    "src/tools/tool-result.js",
    "src/util/value.js"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node scripts/prepare-oss-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "fflate": "0.8.3",
    "read-excel-file": "9.3.10",
    "playwright-core": "1.62.1"
  }
}
