{
  "schemaVersion": 5,
  "tool": "ypscan_parse_requirement",
  "sideEffects": "read-only-external-inference",
  "implementation": "direct-dify-workflow-proxy",
  "endpoint": "https://dfi.eshypdata.com/v1/workflows/run",
  "input": {
    "required": ["demand"],
    "singlePlatformOnly": true,
    "latestCompleteRequirement": true
  },
  "difyOwnedFields": [
    "growBloggerTypeLabel",
    "contentFeatureLabel",
    "contentThemeLabel",
    "kolPersonaLabel",
    "pgyBloggerTypeLabel",
    "xtTalentTypeLabel",
    "industryTagLabel",
    "growTalentTypeLabel",
    "contentTag",
    "brandName",
    "followercount",
    "rebate",
    "kolOfficialPrice",
    "cpm",
    "cpe"
  ],
  "outputPolicy": {
    "preserveDifyValues": true,
    "shape": "data.outputs is the complete untouched Dify outputs object",
    "discardUnknownWorkflowFields": false,
    "currentProviderFragments": [
      "contentTag",
      "followercount",
      "rebate",
      "xhs_kolOfficialPrice",
      "dy_kolOfficialPrice",
      "xhs_cpm",
      "dy_cpm",
      "xhs_cpe",
      "dy_cpe"
    ],
    "currentPlatformBrandCandidates": ["xhsbrandName", "dybrandName"],
    "missingOrConflict": "AskUserQuestion-required; agent-never-autonomously-selects",
    "numericProviderFormat": "all numeric filters are no-space JSON range strings [min,max]; rebate is [min,1]",
    "userEvidence": "submitted identity, quantity, deadline, and optional project dates must match non-empty original or clarification evidence",
    "runtimeBoundary": "before_tool_call normalizes deterministic shapes once and blocks incomplete or invalid Provider writes"
  },
  "agentOwnedFields": "all published validate_requirement fields not listed in difyOwnedFields",
  "changePolicy": {
    "countScope": "one user modification round",
    "zeroOrOneChangedConditions": "agent-updates-without-Dify",
    "twoOrMoreChangedConditions": "rerun-Dify-with-complete-latest-single-platform-demand",
    "rerunInputSource": "latest raw user wording only; never Dify outputs or Provider-normalized values",
    "successfulRerun": "replace-all-Dify-owned-fields-and-reset-change-count"
  },
  "removed": [
    "native compact facts validation",
    "Provider parameter compilation",
    "search job projection",
    "residual condition projection",
    "VALIDATE_REQUIREMENT_ARGS generation"
  ]
}
